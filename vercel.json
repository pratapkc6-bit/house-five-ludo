{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/ludo", "destination": "/index.html" },
    { "source": "/ludo/", "destination": "/index.html" },
    { "source": "/ludo/:path*", "destination": "/:path*" },
    { "source": "/games/ludo", "destination": "/index.html" },
    { "source": "/games/ludo/", "destination": "/index.html" }
  ]
}
